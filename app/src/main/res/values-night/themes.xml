<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ZakatGoldCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/my_dark_primary</item>
        <item name="android:textColorPrimary">@color/my_dark_textColor</item>
        <item name="android:colorBackground">@color/my_dark_background</item>
        <item name="android:toolbarStyle">@color/my_dark_ToolbarStyle</item>
    </style>
    <style name="PopupMenuTheme" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/popup_background</item>
        <item name="android:textColor">@color/popup_text_color</item>
    </style>

    <style name="MyPopupTheme" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColor">@color/white</item>
        <item name="android:colorBackground">@color/black</item>
    </style>

</resources>